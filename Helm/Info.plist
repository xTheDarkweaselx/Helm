<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>UIBackgroundModes</key>
	<array>
		<string>remote-notification</string>
		<string>fetch</string>
		<string>processing</string>
	</array>
	<key>BGTaskSchedulerPermittedIdentifiers</key>
	<array>
		<string>Fusion-Studios.Helm.refresh</string>
		<string>Fusion-Studios.Helm.reimport</string>
	</array>
	<!-- Google OAuth client ID (type "iOS", from the user's own Google Cloud
	     project). Empty by default: the Google Calendar feature stays hidden
	     until a client ID is supplied here or pasted into Settings. Native-app
	     client IDs are public identifiers, not secrets (PKCE, no client secret). -->
	<key>HelmGoogleClientID</key>
	<string></string>
	<key>NSCalendarsFullAccessUsageDescription</key>
	<string>Helm adds your imported work shifts to your calendar and updates or removes them when you re-import a changed roster, so your calendar always matches your latest schedule.</string>
	<key>NSCalendarsUsageDescription</key>
	<string>Helm adds your imported work shifts to your calendar.</string>
	<!-- v7: the app starts the "on shift now" Live Activity (the widget
	     extension renders it). Harmless before the widget target exists. -->
	<key>NSSupportsLiveActivities</key>
	<true/>
</dict>
</plist>
